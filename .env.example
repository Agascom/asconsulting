# Base de données Neon (Postgres)
# Exemple : postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.aws.neon.tech/as-consulting?sslmode=require"

# Clé secrète pour signer les sessions admin (générer avec : openssl rand -base64 32)
AUTH_SECRET="change-me-please-generate-a-long-random-string"

# --- SMTP (optionnel) — utilisé pour envoyer les demandes de contact par email.
# Si non renseigné, les demandes sont uniquement enregistrées en base.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="contact@as-consulting.ga"
MAIL_TO="contact@as-consulting.ga"

# --- Compte admin par défaut créé au moment du seed (prisma db seed)
ADMIN_EMAIL="admin@as-consulting.ga"
ADMIN_PASSWORD="ChangeMe123!"
